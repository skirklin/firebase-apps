rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Recipe Box
    // ==========================================

    match /users/{userId} {
      allow read, write: if userId == request.auth.uid;

      match /boxes/{box} {
        allow read, write: if userId == request.auth.uid;
      }
    }

    match /boxes/{box} {
      // Allow any authenticated user to read box metadata (for joining shared boxes)
      // The box ID acts as a secret invite code
      allow read: if resource == null
        || resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid in resource.data.owners)
        || request.auth != null;
      allow create: if request.auth != null;
      // Allow update if:
      //   1. Already an owner (full access)
      //   2. Self-join: adding yourself to owners (and optionally subscribers), no other changes
      //   3. Self-subscribe: adding yourself to subscribers only, no other changes
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.owners
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners', 'subscribers'])
                && request.resource.data.owners.hasAll(resource.data.owners)
                && request.auth.uid in request.resource.data.owners)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners'])
                && request.resource.data.owners.hasAll(resource.data.owners)
                && request.auth.uid in request.resource.data.owners)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscribers'])
                && (
                  // Subscribe: new array is superset of old + includes self
                  (request.resource.data.subscribers.hasAll(resource.data.get('subscribers', []))
                    && request.auth.uid in request.resource.data.subscribers)
                  // Unsubscribe: old array minus self equals new array
                  || (resource.data.get('subscribers', []).hasAll(request.resource.data.subscribers)
                    && !(request.auth.uid in request.resource.data.subscribers)
                    && request.auth.uid in resource.data.get('subscribers', []))
                )));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      match /recipes/{recipe} {
        // Allow unauthenticated reads for public recipes or recipes in public boxes
        allow read: if resource == null
          || resource.data.visibility == 'public'
          || get(/databases/$(database)/documents/boxes/$(box)).data.visibility == 'public'
          || (request.auth != null && request.auth.uid in resource.data.owners)
          || (request.auth != null && request.auth.uid in get(/databases/$(database)/documents/boxes/$(box)).data.owners)
          || (request.auth != null && get(/databases/$(database)/documents/boxes/$(box)).data.visibility != 'private')
          || (request.auth != null && resource.data.visibility != 'private');
        allow write: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/boxes/$(box)).data.owners
            || (resource != null && request.auth.uid in resource.data.owners));

        match /cookingLog/{logId} {
          allow read, write: if request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/boxes/$(box)).data.owners;
        }
      }

      // Unified events subcollection for cooking logs (and future event types)
      match /events/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/boxes/$(box)).data.owners;
      }
    }

    // ==========================================
    // Groceries
    // ==========================================

    // Note: /users/{userId} is already defined above for Recipe Box
    // with the same permission (userId == auth.uid), so Groceries
    // can use the same collection for user profiles

    match /lists/{listId} {
      // Allow any authenticated user to read list metadata (for joining shared lists)
      // The list ID acts as a secret invite code
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.owners;
      // Allow update if: already an owner, OR adding yourself to owners (for joining)
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.owners
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners'])
                && request.resource.data.owners.hasAll(resource.data.owners)
                && request.auth.uid in request.resource.data.owners));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.owners;
      }

      match /history/{itemName} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.owners;
      }

      match /trips/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.owners;
      }
    }

    // ==========================================
    // Life Tracker
    // ==========================================

    match /lifeLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.owners;
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      // Legacy entries subcollection (kept for migration)
      match /entries/{entryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lifeLogs/$(logId)).data.owners;
      }

      // Unified events subcollection
      match /events/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lifeLogs/$(logId)).data.owners;
      }
    }

    // ==========================================
    // Travel
    // ==========================================

    match /travelLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.owners;
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      match /trips/{tripId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/travelLogs/$(logId)).data.owners;
      }

      match /activities/{activityId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/travelLogs/$(logId)).data.owners;
      }

      match /itineraries/{itineraryId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/travelLogs/$(logId)).data.owners;
      }
    }

    // ==========================================
    // Household Tasks
    // ==========================================

    match /taskLists/{listId} {
      // Allow any authenticated user to read list metadata (for joining shared lists)
      // The list ID acts as a secret invite code
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.owners;
      // Allow update if: already an owner, OR adding yourself to owners (for joining)
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.owners
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owners'])
                && request.resource.data.owners.hasAll(resource.data.owners)
                && request.auth.uid in request.resource.data.owners));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.owners;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/taskLists/$(listId)).data.owners;
      }

      // Legacy completions subcollection (kept for migration)
      match /completions/{completionId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/taskLists/$(listId)).data.owners;
      }

      // Unified events subcollection
      match /events/{eventId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/taskLists/$(listId)).data.owners;
      }
    }
  }
}
